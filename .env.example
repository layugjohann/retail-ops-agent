# Copy to .env.local and fill in what you have. Every key is optional and free-tier (ADR 0001):
# with no key at all, an offline scripted model stands in and nothing needs a network.

# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Gemini free tier (Google AI Studio): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: force a specific Pydantic AI model name, e.g. your own frontier key's model.
# RETAIL_OPS_MODEL=
